{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "name": "pocket-notes",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pocket-notes-db",
      "database_id": "7496f704-e402-4569-9a94-5712f26f1280",
    },
  ],
  "r2_buckets": [
    {
      "bucket_name": "pocket-notes-uploads",
      "binding": "UPLOADS",
    },
  ],
}
