---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import {createAuth} from "../auth";

const session = await createAuth().api.getSession({headers: Astro.request.headers});
---

<BaseLayout pageTitle="Welcome">
	<header class="py-12 text-center">
		<h1 class="text-4xl font-semibold tracking-tight">Pocket Notes</h1>
		<p class="mt-2 text-stone-600">Small notes. Anywhere you go.</p>
	</header>

	<main class="flex justify-center gap-3">
		{session ? (
			<Button href="/notes" label="Go to my notes" />
		) : (
			<>
				<Button href="/signup" label="Sign up" />
				<Button href="/login" label="Log in" variant="ghost" />
			</>
		)}
	</main>
</BaseLayout>
